<en-export export-date="20261101T000000Z" application="Evernote" version="10"><note><title>Banana Bread</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div>Grandma's banana bread</div><div>Serves: 8</div><div>Prep time: 15 min</div>
<div><b>Ingredients</b></div><ul><li>3 ripe bananas</li><li>1/3 cup melted butter</li></ul>
<div>For the topping:</div><ul><li>2 tbsp brown sugar</li></ul>
<div>Directions</div><ol><li>1. Heat oven to 350F.</li><li>2. Mash bananas, stir in butter.</li></ol>
<div>Notes</div><div>Used walnuts last time, better.</div></en-note>]]></content><created>20190314T180000Z</created><tag>Baking</tag><tag>desserts</tag><note-attributes/></note><note><title>Aunt May's card</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div><en-media type="image/png" hash="0ea643a00a3a62c5e369b0620a060171"/></div></en-note>]]></content><created>20190314T180000Z</created><tag>cards</tag><note-attributes/><resource><data encoding="base64">iVBORw0KGgoAAAANSUhEUgAAACgAAAAeCAIAAADRv8uKAAAALklEQVR4nO3NMQEAMAgAoLlcBjOisazg5wMFiK58F/7JKhaLxWKxWCwWi8XilQHCuAG4xBY+yAAAAABJRU5ErkJggg==</data><mime>image/png</mime><resource-attributes><file-name>card.png</file-name></resource-attributes></resource></note><note><title>Best Chili Ever | Example Site</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div>Best Chili Ever</div><div>Ingredients</div><div>1 lb beef</div><div>Instructions</div><div>Brown the beef.</div></en-note>]]></content><created>20190314T180000Z</created><note-attributes><source-url>https://example.invalid/chili</source-url></note-attributes></note><note><title>Shopping</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note><div>milk</div><div>eggs</div></en-note>]]></content><created>20190314T180000Z</created><note-attributes/></note><note><title>Blank</title><content><![CDATA[<?xml version="1.0" encoding="UTF-8"?><!DOCTYPE en-note SYSTEM "http://xml.evernote.com/pub/enml2.dtd"><en-note></en-note>]]></content><created>20190314T180000Z</created><note-attributes/></note></en-export>